{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Meets",
  "version": "0.1.0",
  "identifier": "com.aimeets.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Meets - Real-Time Meeting Translator & Copilot",
        "url": "/index.html",
        "width": 1020,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "AI Meets Subtitles",
        "url": "/overlay.html",
        "width": 940,
        "height": 220,
        "minWidth": 400,
        "minHeight": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "compose",
        "title": "Type & Translate",
        "url": "/compose.html",
        "width": 640,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
